# Release image: distroless + the goreleaser-built engram binary.
# goreleaser places the prebuilt binary in the build context (no source build);
# the standalone source-build path is the top-level Dockerfile.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:aef9602f8710ec12bde19d593fed1f76c708531bb7aba205110f1029786ead7b
COPY engram /engram
EXPOSE 8080
ENTRYPOINT ["/engram", "serve"]
