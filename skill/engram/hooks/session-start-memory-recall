#!/usr/bin/env -S uv run --script
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 Sean Brandt

# /// script
# requires-python = ">=3.11"
# ///
"""SessionStart hook: put the memory scopes, rules index and recall digest in context.

Derives the two-tier memory scope locally (git); outside a repository it prints
nothing. When the `engram` CLI is on PATH it runs `engram prime`, which reads
the rules index and the most recent memories with the CLI's own credential, and
injects that primer. When the binary is missing, has no credential, fails, does
not answer in time or prints nothing, it falls back to instruction text that
tells Claude to call list_rules and list_memory over its own OAuth-authenticated
MCP connection, since a hook cannot hold that token.
"""

from __future__ import annotations

import json
import os
import shutil
import signal
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.scope import derive_scopes  # noqa: E402

# engram prime's own deadline, and the longer bound after which the hook stops
# waiting for it. With scope.py's probes this stays inside the hook's 10 s limit.
PRIME_TIMEOUT = "3s"
PRIME_WAIT_SECONDS = 4

PRECEDENCE = (
    "Memory store precedence — engram is the preferred durable-memory store "
    "for this repo, including over beads. If a beads memory store (`bd "
    "remember` / `bd memories`) is also active here, do NOT treat its "
    "auto-injected memories as sufficient or as the place to write: route "
    "every durable project fact — decisions, conventions, preferences, "
    "gotchas — to engram, search engram first, and treat beads memories as a "
    "read-only fallback only when engram is unavailable (401/403). Never split "
    'durable memory across both stores, and never "lift" facts into engram as '
    "an afterthought — capture them in engram the moment they are established. "
    "(Beads *issues* — `bd create` / `bd ready` — are unrelated: they track "
    "work to *do*, not memory; route actionable work items there, never to "
    "engram.)"
)

CAPTURE = (
    "Capturing durable memory: this repo has a durable-memory capability on "
    "the same engram server. As the session progresses, store durable "
    "facts — decisions, conventions, preferences, gotchas, project-specific "
    "facts that outlive the session — following the curating-memory skill "
    "(search-before-store; supersede-on-contradiction; default to the spine, "
    "overlay only for genuinely work-local facts; never store transient state, "
    "progress, or secrets). search_memory is backed by a semantic/vector "
    "engine, so a natural-language description of the fact surfaces related "
    "records for dedup even without shared keywords. There is no end-of-session "
    "prompt: capture durable facts when they are established, and before you "
    "finish take one moment to store anything durable still unsaved — or move "
    "on silently if nothing durable came up."
)

PRIMER_GUIDANCE = (
    "The rules index and recent memories above were already recalled at session "
    "start by `engram prime`, so there is nothing to recall again before you "
    "answer. The rules are always-shared, user-blessed constraints — treat them "
    "as MUST-follow. The index holds summaries only: when you are about to act "
    "in a rule's concern area, fetch that rule's full text on demand via "
    "mcp__engram__get_memory(<short_id>). The digest is the most recent ~10 "
    "records per scope, not the whole store; search_memory reaches the rest, "
    "and get_memory returns a record's full content. When you cite a record, "
    "use its full short_id verbatim — a truncated prefix is not a valid key."
)


def _rule_scopes(spine: str) -> list[str]:
    """Rule scopes to fetch: rule:<repo-tail> from the spine, plus the optional
    project scope from ENGRAM_PROJECT (client-side hook env var, not the Go
    internal/config registry)."""
    scopes: list[str] = []
    # spine is "repo:<repo-id>"; the rule scope mirrors it under the rule: prefix.
    if spine.startswith("repo:"):
        scopes.append("rule:" + spine)  # rule:repo:<repo-id>
    project = os.environ.get("ENGRAM_PROJECT", "").strip()
    if project:
        scopes.append(f"rule:project:{project}")
    return scopes


def _fallback_context(spine: str, overlay: str | None) -> str:
    lines = [f"Memory spine scope: {spine}"]
    if overlay:
        lines.append(f"Memory workspace scope: {overlay}")
    which = "the spine, and the workspace overlay if present" if overlay else "the spine"
    lines.append("")
    lines.append(
        "REQUIRED FIRST ACTION — recall durable memory before your first "
        f"substantive response: call mcp__engram__list_memory once per scope above "
        f"({which}) with limit 10 (most recent first) and read the results. This "
        "is a hard prerequisite, not background context, and it is NOT satisfied "
        "by any other store: even if beads (`bd prime`) has already printed its "
        "own memories into this session, those are a DIFFERENT store — engram is "
        "empty in your context until you pull it, and you cannot search-before-"
        "store against a spine you have never read. Do not skip or defer this "
        "because the user's request feels urgent or self-contained, and do not "
        "assume memory is \"already loaded\" because something else injected some "
        "at startup. A one-shot list_memory call is cheap; working blind against a "
        "populated engram spine is the exact failure this hook exists to prevent. "
        "Render the results as a visible, bounded digest — one terse bullet per "
        "record (its compact summary as returned, not expanded to full content), "
        "preferring the spine record on duplicate ids, grouped as \"Repo-wide "
        "memories\" and \"This workspace's memories\", and silently omitting any "
        "group that returns nothing. If a bullet cites a record's id, it MUST use "
        "the full short_id (or full UUID) verbatim — a truncated prefix is not a "
        "valid get_memory key; prefer the record's short_id as the compact handle. "
        "This digest is the most recent ~10 per scope, "
        "not the whole store; printing it doubles as proof you actually recalled. "
        "If a scope comes back full (10 records), add a one-line footer noting "
        "older memories remain and are reachable via search_memory or a higher "
        "list_memory limit. Recall returns compact summaries by "
        "default (this is what keeps the spine bootstrap small); full content is "
        "one get_memory call away (accepts either the id or the short_id). If "
        "engram returns 401/403 it is not "
        "authenticated: say once that memories are unavailable and the user can "
        "authenticate via /mcp (engram -> Authenticate), then continue without "
        "blocking — and in that case only, fall back to `bd memories <keyword>` if "
        "a beads memory store is present."
    )
    lines += ["", PRECEDENCE, "", CAPTURE]
    rule_scopes = _rule_scopes(spine)
    if rule_scopes:
        lines.append("")
        joined = ", ".join(rule_scopes)
        lines.append(
            "Repository rules (normative ground truth) — as a distinct Rules "
            f"index section ABOVE the recall digest, call mcp__engram__list_rules "
            f"once with scopes=[{joined}] and render one line per rule as "
            "`short_id — summary [tags]`. "
            "This is an INDEX only, not the full rules: do NOT fetch or inline rule "
            "content at startup. When you are about to act in a rule's concern area, "
            "fetch that one rule's full text on demand via get_memory(<short_id>). "
            "If list_rules returns nothing, omit the Rules section entirely. Rules "
            "are always-shared, user-blessed constraints — treat them as MUST-follow."
        )
    return "\n".join(lines)


def _run_prime(cwd: str) -> str | None:
    """Run `engram prime` from cwd; return its primer, or None to fall back.

    prime derives its own scope from cwd, never reads stdin, and bounds itself
    with --timeout. The hook still stops waiting after PRIME_WAIT_SECONDS and
    kills prime's whole process group, so a wrapper script that does not exec
    cannot hold the pipes open past the hook's limit.
    """
    engram = shutil.which("engram")
    if engram is None:
        return None
    try:
        proc = subprocess.Popen(
            [engram, "prime", "--timeout", PRIME_TIMEOUT],
            cwd=cwd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
        )
    except OSError as exc:
        print(f"session-start-memory-recall: engram prime: {exc}", file=sys.stderr)
        return None
    try:
        out, err = proc.communicate(timeout=PRIME_WAIT_SECONDS)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        proc.communicate()
        print(
            f"session-start-memory-recall: engram prime did not finish in "
            f"{PRIME_WAIT_SECONDS} s; using the instruction text",
            file=sys.stderr,
        )
        return None
    if proc.returncode != 0 or not out.strip():
        detail = err.strip().splitlines()[-1] if err.strip() else "no output"
        print(
            f"session-start-memory-recall: engram prime exited {proc.returncode} "
            f"({detail}); using the instruction text",
            file=sys.stderr,
        )
        return None
    return out


def main() -> None:
    try:
        raw = sys.stdin.read()
        data = json.loads(raw) if raw.strip() else {}
    except (json.JSONDecodeError, OSError):
        sys.exit(0)

    cwd = data.get("cwd", os.getcwd())
    try:
        spine, overlay = derive_scopes(cwd)
    except Exception as exc:
        print(f"session-start-memory-recall: scope derivation failed: {exc}", file=sys.stderr)
        sys.exit(0)

    if spine is None:
        sys.exit(0)

    primer = _run_prime(cwd)
    if primer is not None:
        context = "\n\n".join([primer.rstrip(), PRIMER_GUIDANCE, PRECEDENCE, CAPTURE])
    else:
        context = _fallback_context(spine, overlay)
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": context,
        }
    }))
    sys.exit(0)


if __name__ == "__main__":
    main()
