    {
      "name": "setup",
      "summary": "Detect installed agent runtimes and preview registering engram as an MCP server",
      "flags": [
        {
          "name": "apply",
          "type": "bool",
          "default": "false",
          "usage": "a mutating operator command previews by default and mutates only when apply is set"
        },
        {
          "name": "auth",
          "type": "string",
          "default": "oauth",
          "usage": "auth mode: \"oauth\", \"oauth-client\", \"bearer\", or \"none\" (default: ENGRAM_AUTH)"
        },
        {
          "name": "callback-port",
          "type": "string",
          "default": "",
          "usage": "fixed OAuth callback port (1-65535) for the redirect URI the runtime registers; valid with --auth oauth or oauth-client only; claude-code passes it as claude mcp add --callback-port, codex and opencode report a failed row (default: ENGRAM_CALLBACK_PORT)"
        },
        {
          "name": "client-id",
          "type": "string",
          "default": "",
          "usage": "non-secret OAuth client ID; required for --auth oauth-client; other auth modes reject this flag"
        },
        {
          "name": "header",
          "type": "stringSlice",
          "default": "",
          "usage": "additional HTTP header as NAME=ENVVAR, where ENVVAR names the environment variable the runtime resolves itself at connect time — never a value; repeatable or comma-separated; valid with every --auth mode; codex has no custom-header flag and reports a failed row (default: ENGRAM_HEADERS)"
        },
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout); text is a human-readable view, not a stable interface — script against json"
        },
        {
          "name": "runtime",
          "type": "stringSlice",
          "default": "",
          "usage": "runtimes to target, comma-separated or repeated (default: every detected runtime); valid values: claude-code, codex, opencode, generic (default: ENGRAM_RUNTIME)"
        },
        {
          "name": "token-file",
          "type": "string",
          "default": "",
          "usage": "path naming the bearer credential's provenance for the portable configuration (--runtime generic) — carries only the PATH, never the secret itself; has no effect for a natively-registered runtime (claude-code, codex, opencode), which resolves the credential itself from its own environment at connect time"
        },
        {
          "name": "url",
          "type": "string",
          "default": "",
          "usage": "MCP endpoint URL to register, used verbatim — never appended to or stripped (required) (default: ENGRAM_URL)"
        }
      ],
      "blast_radius": {
        "read_only": false,
        "destructive": true,
        "idempotent": true,
        "open_world": false
      }
