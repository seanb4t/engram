      "blast_radius": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "prime",
      "summary": "Print a session primer for an agent: memory scope, rules index and recent memories",
      "flags": [
        {
          "name": "insecure",
          "type": "bool",
          "default": "false",
          "usage": "skip TLS certificate verification (always warns on stderr; no environment fallback)"
        },
        {
          "name": "output",
          "type": "string",
          "default": "text",
          "usage": "output format: \"text\" or \"json\"; text whether or not stdout is a terminal"
        },
        {
          "name": "scope",
          "type": "string",
          "default": "",
          "usage": "memory scope to read, used exactly as given with no workspace overlay (default: ENGRAM_SCOPE, then the scope derived from local git)"
        },
        {
          "name": "server",
          "type": "string",
          "default": "",
          "usage": "engram server base URL (default: ENGRAM_SERVER_URL)"
        },
        {
          "name": "timeout",
          "type": "string",
          "default": "30s",
          "usage": "deadline for the whole command: git probes, the credential and every request together (must be \u003e 0, e.g. 3s, 30s; a value of 0 is rejected)"
        },
        {
          "name": "token-file",
          "type": "string",
          "default": "",
          "usage": "path to a file containing the bearer credential (default: ENGRAM_TOKEN env var)"
        }
      ],
      "blast_radius": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "prune-expired",
      "summary": "Delete memories whose validity window (not_after) has lapsed",
      "flags": [
        {
          "name": "apply",
          "type": "bool",
          "default": "false",
          "usage": "a mutating operator command previews by default and mutates only when apply is set"
        },
        {
          "name": "older-than",
          "type": "duration",
          "default": "0s",
          "usage": "grace period: only prune records whose not_after lapsed at least this long ago (0 = any past not_after)"
        },
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout); text is a human-readable view, not a stable interface — script against json"
        },
        {
          "name": "timeout",
          "type": "duration",
          "default": "5m0s",
          "usage": "max wall-clock for the sweep (0 disables); also cancellable via Ctrl-C"
        }
      ],
      "blast_radius": {
        "read_only": false,
        "destructive": true,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "reindex",
      "summary": "Re-embed memories into a new (new-dimension) collection for embedder migration",
      "flags": [
        {
          "name": "dry-run",
          "type": "bool",
          "default": "false",
          "usage": "scan and count without creating the target or writing"
        },
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout); text is a human-readable view, not a stable interface — script against json"
        },
        {
          "name": "resume",
          "type": "bool",
          "default": "false",
          "usage": "skip points already present in the target with identical content (cheap restart of an interrupted reindex)"
        },
        {
          "name": "source",
          "type": "string",
          "default": "",
          "usage": "source collection to read from (default: ENGRAM_QDRANT_COLLECTION)"
        },
        {
          "name": "target",
          "type": "string",
          "default": "",
          "usage": "target collection to create and populate (required)"
        },
        {
          "name": "timeout",
          "type": "duration",
          "default": "30m0s",
          "usage": "max wall-clock for the reindex; 0 means no deadline (Ctrl-C or SIGTERM aborts either way)"
        }
      ],
      "blast_radius": {
        "read_only": false,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "related",
      "summary": "Show one memory's neighbourhood: supersession, shared tags, shared citations and vector neighbours",
      "flags": [
        {
          "name": "full",
          "type": "bool",
          "default": "false",
          "usage": "return full content for the anchor and every related record instead of summaries"
        },
        {
          "name": "insecure",
          "type": "bool",
          "default": "false",
          "usage": "skip TLS certificate verification (always warns on stderr; no environment fallback)"
        },
        {
          "name": "k",
          "type": "uint64",
          "default": "0",
          "usage": "max vector neighbours; 0 resolves to the default, 8; a value above the maximum, 1000, is rejected"
        },
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout)"
        },
        {
          "name": "server",
          "type": "string",
          "default": "",
          "usage": "engram server base URL (default: ENGRAM_SERVER_URL)"
        },
        {
          "name": "timeout",
          "type": "string",
          "default": "30s",
          "usage": "per-request client deadline (must be \u003e 0, e.g. 30s, 2m; a value of 0 is rejected, never treated as unbounded — unlike this binary's operator-command --timeout, where 0 disables)"
        },
        {
          "name": "token-file",
          "type": "string",
          "default": "",
          "usage": "path to a file containing the bearer credential (default: ENGRAM_TOKEN env var)"
        }
      ],
      "blast_radius": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "restore",
      "summary": "Restore one or more archived memories you own",
      "flags": [
        {
          "name": "insecure",
          "type": "bool",
          "default": "false",
          "usage": "skip TLS certificate verification (always warns on stderr; no environment fallback)"
        },
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout)"
        },
        {
          "name": "server",
          "type": "string",
          "default": "",
          "usage": "engram server base URL (default: ENGRAM_SERVER_URL)"
        },
        {
          "name": "timeout",
          "type": "string",
          "default": "30s",
          "usage": "per-request client deadline (must be \u003e 0, e.g. 30s, 2m; a value of 0 is rejected, never treated as unbounded — unlike this binary's operator-command --timeout, where 0 disables)"
        },
        {
          "name": "token-file",
          "type": "string",
          "default": "",
          "usage": "path to a file containing the bearer credential (default: ENGRAM_TOKEN env var)"
        }
