          "usage": "free-form filter: only this category; the free-form filter path requires an explicit --scope or --all-scopes: category or tags always engage it, and older-than engages it when no class is selected"
        },
        {
          "name": "class",
          "type": "stringSlice",
          "default": "[]",
          "usage": "structural eligibility class (repeatable): superseded, expired, archived"
        },
        {
          "name": "older-than",
          "type": "duration",
          "default": "0s",
          "usage": "grace/retention window override for the selected class(es) (0 = each class's own default: immediate for superseded/expired, 90 days for archived); with NO class selected, a free-form created-more-than-this-long-ago filter -- the free-form filter path requires an explicit --scope or --all-scopes: category or tags always engage it, and older-than engages it when no class is selected"
        },
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout); text is a human-readable view, not a stable interface — script against json"
        },
        {
