    {
      "name": "rules",
      "summary": "List the rules in one or more rule scopes, or every readable rule scope",
      "flags": [
        {
          "name": "full",
          "type": "bool",
          "default": "false",
          "usage": "return full rule content instead of the compact index shape"
        },
