    {
      "name": "spine-review consolidate",
      "summary": "Report ranked near-duplicate candidate pairs across the memory spine",
      "flags": [
        {
          "name": "all-scopes",
          "type": "bool",
          "default": "false",
          "usage": "span every scope (required if --scope is omitted); mutually exclusive with --scope; a candidate pair may then cross scopes, and each row names both; a sweep requires an explicit --scope or --all-scopes: name one scope, or opt into every scope"
        },
        {
          "name": "min-score",
          "type": "string",
          "default": "",
          "usage": "minimum cosine score a pair must carry to be reported; absent (the default) means NO filter at all — including pairs with a negative score"
        },
        {
          "name": "no-verdicts",
          "type": "bool",
          "default": "false",
          "usage": "skip the advisory verdict pass even when ENGRAM_DECISIONS_PROVIDER is set — no record content is sent and no verdict objects appear (see --verdict-threshold)"
        },
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout); text is a human-readable view, not a stable interface — script against json"
        },
        {
          "name": "scope",
          "type": "string",
          "default": "",
          "usage": "only consider records in this scope"
        },
        {
          "name": "timeout",
          "type": "duration",
          "default": "5m0s",
          "usage": "max wall-clock for the sweep (0 disables); also cancellable via Ctrl-C"
        },
        {
          "name": "top-k",
          "type": "uint64",
          "default": "5",
          "usage": "neighbours considered per record"
        },
        {
          "name": "verdict-threshold",
          "type": "string",
          "default": "",
          "usage": "the probability between 0 and 1 below which a verdict is marked needs_review; overrides ENGRAM_DECISIONS_VERDICT_THRESHOLD (default 0.9) for this run; no effect without ENGRAM_DECISIONS_PROVIDER or with --no-verdicts"
        }
      ],
      "blast_radius": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "spine-review purge",
      "summary": "Delete purge-eligible records, gated on an extraction precondition",
      "flags": [
        {
          "name": "all-scopes",
          "type": "bool",
          "default": "false",
          "usage": "span every scope; mutually exclusive with --scope"
        },
        {
          "name": "apply",
          "type": "bool",
          "default": "false",
