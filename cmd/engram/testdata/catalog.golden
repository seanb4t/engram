{
  "binary": "engram",
  "version": "test-version",
  "commands": [
    {
      "name": "archive",
      "summary": "Archive one or more memories you own (reversible with restore)",
      "flags": [
        {
          "name": "insecure",
          "type": "bool",
          "default": "false",
          "usage": "skip TLS certificate verification (always warns on stderr; no environment fallback)"
        },
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout)"
        },
        {
          "name": "server",
          "type": "string",
          "default": "",
          "usage": "engram server base URL (default: ENGRAM_SERVER_URL)"
        },
        {
          "name": "timeout",
          "type": "string",
          "default": "30s",
          "usage": "per-request client deadline (must be \u003e 0, e.g. 30s, 2m; a value of 0 is rejected, never treated as unbounded — unlike this binary's operator-command --timeout, where 0 disables)"
        },
        {
          "name": "token-file",
          "type": "string",
          "default": "",
          "usage": "path to a file containing the bearer credential (default: ENGRAM_TOKEN env var)"
        }
      ],
      "blast_radius": {
        "read_only": false,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "backfill-short-ids",
      "summary": "Assign a short_id to every memory that lacks one (payload-only; no re-embed)",
      "flags": [
        {
          "name": "apply",
          "type": "bool",
          "default": "false",
          "usage": "a mutating operator command previews by default and mutates only when apply is set"
        },
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout); text is a human-readable view, not a stable interface — script against json"
        },
        {
          "name": "timeout",
          "type": "duration",
          "default": "5m0s",
          "usage": "max wall-clock (0 disables); also cancellable via Ctrl-C"
        }
      ],
      "blast_radius": {
        "read_only": false,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "catalog",
      "summary": "Print the machine-readable catalog of every command, flag and exit code as JSON",
      "flags": [],
      "blast_radius": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "delete",
      "summary": "Delete one memory you own: preview by default, delete under --apply",
      "flags": [
        {
          "name": "apply",
          "type": "bool",
          "default": "false",
          "usage": "a mutating operator command previews by default and mutates only when apply is set"
        },
        {
          "name": "insecure",
          "type": "bool",
          "default": "false",
          "usage": "skip TLS certificate verification (always warns on stderr; no environment fallback)"
        },
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout)"
        },
        {
          "name": "server",
          "type": "string",
          "default": "",
          "usage": "engram server base URL (default: ENGRAM_SERVER_URL)"
        },
        {
          "name": "timeout",
          "type": "string",
          "default": "30s",
          "usage": "per-request client deadline (must be \u003e 0, e.g. 30s, 2m; a value of 0 is rejected, never treated as unbounded — unlike this binary's operator-command --timeout, where 0 disables)"
        },
        {
          "name": "token-file",
          "type": "string",
          "default": "",
          "usage": "path to a file containing the bearer credential (default: ENGRAM_TOKEN env var)"
        }
      ],
      "blast_radius": {
        "read_only": false,
        "destructive": true,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "get",
      "summary": "Fetch one memory by id or short id and render its full state",
      "flags": [
        {
          "name": "insecure",
          "type": "bool",
          "default": "false",
          "usage": "skip TLS certificate verification (always warns on stderr; no environment fallback)"
        },
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout)"
        },
        {
          "name": "server",
          "type": "string",
          "default": "",
          "usage": "engram server base URL (default: ENGRAM_SERVER_URL)"
        },
        {
          "name": "timeout",
          "type": "string",
          "default": "30s",
          "usage": "per-request client deadline (must be \u003e 0, e.g. 30s, 2m; a value of 0 is rejected, never treated as unbounded — unlike this binary's operator-command --timeout, where 0 disables)"
        },
        {
          "name": "token-file",
          "type": "string",
          "default": "",
          "usage": "path to a file containing the bearer credential (default: ENGRAM_TOKEN env var)"
        }
      ],
      "blast_radius": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "list",
      "summary": "List memories on a remote engram server",
      "flags": [
        {
          "name": "categories",
          "type": "stringSlice",
          "default": "[]",
          "usage": "category filter (empty = all categories)"
        },
        {
          "name": "created-after",
          "type": "string",
          "default": "",
          "usage": "RFC3339 inclusive lower bound on created_at"
        },
        {
          "name": "created-before",
          "type": "string",
          "default": "",
          "usage": "RFC3339 exclusive upper bound on created_at"
        },
        {
          "name": "cross-spine",
          "type": "bool",
          "default": "false",
          "usage": "span every scope you can read; mutually exclusive with --scope"
        },
        {
          "name": "cursor-mode",
          "type": "bool",
          "default": "false",
          "usage": "opt into cursor paging on the first (tokenless) page; cursor_mode, offset, and page_token are mutually exclusive"
        },
        {
          "name": "full",
          "type": "bool",
          "default": "false",
          "usage": "return full content instead of summaries"
        },
        {
          "name": "include-archived",
          "type": "bool",
          "default": "false",
          "usage": "include archived records, which are hidden by default"
        },
        {
          "name": "include-scheduled",
          "type": "bool",
          "default": "false",
          "usage": "include records outside their validity window (not-yet-active AND already-expired), which are hidden by default"
        },
        {
          "name": "include-superseded",
          "type": "bool",
          "default": "false",
          "usage": "include superseded records, which are hidden by default"
        },
        {
          "name": "insecure",
          "type": "bool",
          "default": "false",
          "usage": "skip TLS certificate verification (always warns on stderr; no environment fallback)"
        },
        {
          "name": "limit",
          "type": "uint64",
          "default": "0",
          "usage": "max results per page; 0 resolves to the maximum, 1000; a larger value is rejected"
        },
        {
          "name": "offset",
          "type": "uint64",
          "default": "0",
          "usage": "offset-for-UI paging; cursor_mode, offset, and page_token are mutually exclusive"
        },
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout)"
        },
        {
          "name": "page-token",
          "type": "string",
          "default": "",
          "usage": "opaque cursor from a previous response's next_page_token; cursor_mode, offset, and page_token are mutually exclusive"
        },
        {
          "name": "scope",
          "type": "string",
          "default": "",
          "usage": "scope is required unless cross_spine is true; omit and pass --cross-spine to span every scope you can read; mutually exclusive with --cross-spine"
        },
        {
          "name": "server",
          "type": "string",
          "default": "",
          "usage": "engram server base URL (default: ENGRAM_SERVER_URL)"
        },
        {
          "name": "tags",
          "type": "stringSlice",
          "default": "[]",
          "usage": "tag filter (records must carry ALL listed tags)"
        },
        {
          "name": "timeout",
          "type": "string",
          "default": "30s",
          "usage": "per-request client deadline (must be \u003e 0, e.g. 30s, 2m; a value of 0 is rejected, never treated as unbounded — unlike this binary's operator-command --timeout, where 0 disables)"
        },
        {
          "name": "token-file",
          "type": "string",
          "default": "",
          "usage": "path to a file containing the bearer credential (default: ENGRAM_TOKEN env var)"
        },
        {
          "name": "visibility",
          "type": "string",
          "default": "",
          "usage": "visibility filter: \"\" (all), \"private\", or \"shared\""
        }
      ],
      "blast_radius": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "login",
      "summary": "Log in to an engram server with your browser and cache a refreshable credential",
      "flags": [
        {
          "name": "client-id",
          "type": "string",
          "default": "",
          "usage": "pre-registered OAuth client ID, for an issuer without dynamic client registration (default: ENGRAM_CLIENT_ID)"
        },
        {
          "name": "insecure",
          "type": "bool",
          "default": "false",
          "usage": "skip TLS certificate verification for the engram server only, never for the issuer (always warns on stderr; no environment fallback)"
        },
        {
          "name": "server",
          "type": "string",
          "default": "",
          "usage": "engram server base URL to log in to (default: ENGRAM_SERVER_URL)"
        }
      ],
      "blast_radius": {
        "read_only": false,
        "destructive": false,
        "idempotent": false,
        "open_world": false
      }
    },
    {
      "name": "logout",
      "summary": "Remove the cached login for an engram server and revoke it at the issuer",
      "flags": [
        {
          "name": "server",
          "type": "string",
          "default": "",
          "usage": "engram server base URL to log out of (default: ENGRAM_SERVER_URL, else the default server)"
        }
      ],
      "blast_radius": {
        "read_only": false,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "migrate",
      "summary": "Preview or apply the pending forward schema-version sweep",
      "flags": [
        {
          "name": "apply",
          "type": "bool",
          "default": "false",
          "usage": "a mutating operator command previews by default and mutates only when apply is set"
        },
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout); text is a human-readable view, not a stable interface — script against json"
        },
        {
          "name": "timeout",
          "type": "duration",
          "default": "5m0s",
          "usage": "max wall-clock (0 disables); also cancellable via Ctrl-C"
        }
      ],
      "blast_radius": {
        "read_only": false,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "migrate revert",
      "summary": "Preview or apply a reverse schema-version walk, refusing any irreversible range whole",
      "flags": [
        {
          "name": "apply",
          "type": "bool",
          "default": "false",
          "usage": "a mutating operator command previews by default and mutates only when apply is set"
        },
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout); text is a human-readable view, not a stable interface — script against json"
        },
        {
          "name": "timeout",
          "type": "duration",
          "default": "5m0s",
          "usage": "max wall-clock (0 disables); also cancellable via Ctrl-C"
        },
        {
          "name": "to",
          "type": "int",
          "default": "0",
          "usage": "target schema version to revert down to (required)"
        }
      ],
      "blast_radius": {
        "read_only": false,
        "destructive": true,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "migrate status",
      "summary": "Report a server-side schema-version distribution histogram",
      "flags": [
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout); text is a human-readable view, not a stable interface — script against json"
        },
        {
          "name": "timeout",
          "type": "duration",
          "default": "5m0s",
          "usage": "max wall-clock (0 disables); also cancellable via Ctrl-C"
        }
      ],
      "blast_radius": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "migrate-remap-owner",
      "summary": "Re-stamp record owner across the collection (sub-\u003eemail, email-\u003eemail, owner-less, or anonymous bucket)",
      "flags": [
        {
          "name": "apply",
          "type": "bool",
          "default": "false",
          "usage": "a mutating operator command previews by default and mutates only when apply is set"
        },
        {
          "name": "from",
          "type": "string",
          "default": "",
          "usage": "current owner value to remap (a sub or email); mutually exclusive with --from-missing/--from-anon"
        },
        {
          "name": "from-anon",
          "type": "bool",
          "default": "false",
          "usage": "remap the explicit anonymous bucket (owner==\"\")"
        },
        {
          "name": "from-missing",
          "type": "bool",
          "default": "false",
          "usage": "remap owner-less (pre-isolation) records"
        },
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout); text is a human-readable view, not a stable interface — script against json"
        },
        {
          "name": "timeout",
          "type": "duration",
          "default": "5m0s",
          "usage": "max wall-clock (must be \u003e 0); also cancellable via Ctrl-C"
        },
        {
          "name": "to",
          "type": "string",
          "default": "",
          "usage": "new owner value to stamp (required)"
        }
      ],
      "blast_radius": {
        "read_only": false,
        "destructive": true,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "migrate-set-owner",
      "summary": "Backfill owner (OIDC sub) onto pre-isolation memory records",
      "flags": [
        {
          "name": "output",
          "type": "string",
          "default": "",
          "usage": "output format: \"json\" or \"text\" (default: detect from stdout); text is a human-readable view, not a stable interface — script against json"
        },
        {
          "name": "owner",
          "type": "string",
          "default": "",
          "usage": "OIDC sub to stamp onto owner-less records (required, non-empty)"
        },
        {
          "name": "timeout",
          "type": "duration",
          "default": "5m0s",
          "usage": "max wall-clock for the backfill (must be \u003e 0); also cancellable via Ctrl-C"
        }
      ],
      "blast_radius": {
        "read_only": false,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      }
    },
    {
      "name": "migration-status",
