# yamlfmt configuration — https://github.com/google/yamlfmt
formatter:
  type: basic
  indent: 2
  max_line_length: 120
  include_document_start: false
  retain_line_breaks: true
  trim_trailing_whitespace: true
  eof_newline: true
  pad_line_comments: 1
exclude:
  - .beads/ # beads-managed config (written without trailing newline)
  - .worktrees/
  - dist/
  - vendor/
  - bin/
  - charts/engram/templates/ # Helm templates ({{ }}) are not plain YAML
  - docs-site/ # Astro/pnpm project (its own YAML/JSONC config, generated output)
  - ui/pnpm-lock.yaml # generated lockfile (pnpm-owned; long dependency lines fail max_line_length)
